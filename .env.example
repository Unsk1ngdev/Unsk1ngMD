# =============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example) - Unsk1ngMD
# =============================================================================
# Copia este archivo como '.env' y completa los valores correspondientes.
# ADVERTENCIA: NUNCA compartas ni subas tu archivo '.env' real a GitHub.

# -----------------------------------------------------------------------------
# 1. Inteligencia Artificial (Groq Cloud)
# -----------------------------------------------------------------------------
# Clave API oficial de Groq Cloud (Obtenla gratis en: https://console.groq.com/keys)
GROQ_API_KEY=""

# Modelo de Groq Cloud (Opcional, por defecto: llama-3.3-70b-versatile)
GROQ_MODEL="llama-3.3-70b-versatile"

# -----------------------------------------------------------------------------
# 2. Configuración del Bot y Dueño
# -----------------------------------------------------------------------------
# Número telefónico del creador con código de país (sin símbolos ni espacios, ej: 584160666286)
OWNER_NUMBER=""

# Nombre del creador
OWNER_NAME="Unknown Codexツ</>"

# Nombre del bot
BOT_NAME="Unsk1ngMD"

# Prefijo predeterminado de comandos (ej: .)
DEFAULT_PREFIX="."

# Modo de ejecución ('public' o 'private')
BOT_MODE="public"

# -----------------------------------------------------------------------------
# 3. Metadatos de Stickers (EXIF WebP)
# -----------------------------------------------------------------------------
PACK_NAME="Unsk1ngMD"
AUTHOR_NAME="Unknown Codexツ</>"

# -----------------------------------------------------------------------------
# 4. Seguridad de Copias de Respaldo (.backup)
# -----------------------------------------------------------------------------
# Contraseña secreta para cifrado autenticado AES-256-GCM de sesiones de WhatsApp
# Requerida obligatoriamente para generar .backup seguro. Mínimo 8 caracteres.
BACKUP_PASSWORD=""

# -----------------------------------------------------------------------------
# 5. Token de consulta DNI Perú (Opcional)
# -----------------------------------------------------------------------------
PERU_TOKEN=""

# -----------------------------------------------------------------------------
# 6. Token de Bot de Discord (Opcional para .discord)
# -----------------------------------------------------------------------------
DISCORD_TOKEN=""

# -----------------------------------------------------------------------------
# 7. OSINT & Ciberinteligencia (Opcional para .osint)
# -----------------------------------------------------------------------------
# Clave API de HaveIBeenPwned para verificación de filtraciones de email (opcional)
# Obtenla en: https://haveibeenpwned.com/API/Key
HIBP_KEY=""

# Clave API de Numverify para validación y operadora de números telefónicos (opcional)
# Obtenla gratis en: https://numverify.com/
NUMVERIFY_KEY=""

# Clave API de AbstractAPI para validación de números telefónicos (opcional)
# Obtenla gratis en: https://www.abstractapi.com/api/phone-validation-api
ABSTRACTAPI_KEY=""

# Clave API de AbstractAPI para validación y auditoría de emails (opcional)
# Obtenla gratis en: https://www.abstractapi.com/api/email-verification-validation-api
ABSTRACTAPI_EMAIL_KEY=""

# Clave API de AbstractAPI para geolocalización e inteligencia de IP (opcional)
# Obtenla gratis en: https://www.abstractapi.com/api/ip-geolocation-api
ABSTRACTAPI_IP_KEY=""

# -----------------------------------------------------------------------------
# 8. Alojamiento de Imágenes (ImgBB - .imglink)
# -----------------------------------------------------------------------------
# Clave API oficial de ImgBB (Obtenla gratis en: https://api.imgbb.com)
IMGBB_KEY=""
